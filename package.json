{
  "name": "dezhou",
  "version": "1.0.0",
  "description": "",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:component": "vitest run --project component",
    "test:guards": "vitest run src/guards src/i18n src/shared/admission-guard.test.ts src/features/eslint-guard-dependency-graph.test.ts",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "size:check": "node scripts/check-bundle-size.mjs",
    "repo:check": "node scripts/check-repo-hygiene.mjs",
    "docs:check": "node scripts/check-doc-links.mjs",
    "theory:manifest": "node scripts/generate-theory-manifest.mjs",
    "academy:manifest": "node scripts/generate-academy-manifest.mjs",
    "agents:map": "node scripts/generate-agent-map.mjs",
    "agents:map:check": "node scripts/generate-agent-map.mjs --check",
    "verify": "pnpm typecheck && pnpm lint && pnpm repo:check && pnpm docs:check && pnpm agents:map:check && pnpm test",
    "verify:parallel": "pwsh -NoProfile -File scripts/parallel-verify.ps1"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.18.0",
      "onFail": "download"
    }
  },
  "type": "module",
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-progress": "^1.1.12",
    "@radix-ui/react-select": "^2.3.3",
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-tooltip": "^1.2.12",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.42.2",
    "i18next": "^26.3.6",
    "lucide-react": "^1.25.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-i18next": "^17.0.10",
    "react-router-dom": "^7.18.1",
    "recharts": "^3.9.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "4.1.10",
    "axe-core": "^4.13.0",
    "eslint": "^10.8.0",
    "fake-indexeddb": "^6.2.7",
    "jsdom": "^30.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@11.18.0"
}
