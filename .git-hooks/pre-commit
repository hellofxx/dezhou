#!/usr/bin/env bash
# Agent Tools Validation + Quality Gate Pre-commit Hook
# 
# 1. Agent tools validation (when .claude/agents/*.md changes) - warning non-blocking
# 2. ESLint verification (always blocking) - prevents forbidden import edges
#
# Memory note (Git-Hook 跨平台兼容):
# - Windows (PowerShell/Git Bash): ensure core.hooksPath points to this dir; chmod +x may not work but Git for Windows usually handles it
# - Linux/macOS: chmod +x required for script execution, else silently skipped
#
# AGENTS.md §质量门禁："每次代码变更后必须运行 pnpm verify"，本 hook 执行 pnpm lint（秒级）而非完整 verify。

echo "🔍 Running quality gate checks..."

# Check if any source files changed
if ! git diff --name-only HEAD | grep -qE '\.(ts|tsx|js|jsx)$'; then
  echo "✓ No source code changes detected, skipping lint."
else
  echo "⚠️ Linting source files..."
  cd $(git rev-parse --show-toplevel)
  # Try pnpm first, fallback to npx if not available
  if command -v pnpm > /dev/null 2>&1; then
    pnpm lint
  elif [ -f "$APPDATA/npm/node_modules/.bin/eslint.cmd" ]; then
    "$APPDATA/npm/node_modules/.bin/eslint.cmd" src
  else
    echo "⚠️ pnpm not found, skipping lint in pre-commit (run 'pnpm verify' manually)"
    exit 0
  fi
  RESULT=$?
  
  if [ $RESULT -ne 0 ]; then
    echo "❌ ESLint FAILED. Fix issues before committing."
    exit 1
  else
    echo "✅ ESLint passed."
  fi
fi

echo ""
echo "⚠️ Detecting changes to agent files..."

if git diff --name-only HEAD | grep -q '\.claude/agents/.*-dev\.md'; then
  echo "🔍 Running agent tools validation..."
  node scripts/validate-agent-tools.ts
  RESULT=$?
  
  if [ $RESULT -eq 1 ]; then
    echo "❌ Agent tools validation FAILED"
    echo "Please fix errors before committing."
    exit 1
  elif [ $RESULT -eq 0 ]; then
    echo "✅ Agent tools validation passed (warnings allowed)"
  else
    echo "❌ Agent tools validation errored (exit code $RESULT)"
    echo "Treating unexpected exit code as failure to avoid fail-open."
    exit 1
  fi
else
  echo "✓ No agent file changes detected, skipping validation."
fi

exit 0
