// ============================================================================
// PokerLab · 模块依赖与共享契约图（当前态 / current-state）
// 生成：system-modeler + graphviz（architecture-visualization 插件）
// 证据基线：工作树 @ HEAD c966912（含未提交改动），采集时间 2026-08-30
// 边证据：代码中 `@/features/*` / `@/shared/*` import 实测 +
//         eslint.config.js ALLOWED_CROSS_IMPORTS + src/eslintCrossImports.test.ts 快照守卫
//
// 本图回答一个问题：谁依赖谁，跨模块通信一共有几条通道。
//   黑色实线 = 代码实测 import（confidence: high）
//   灰色虚线 = 运行时/构建期关系，或导出但内部未见消费方（confidence: medium/low）
//   蓝边     = shared/ 共享层通道
//   青边     = trainingEvents 事件总线（异步）
//   紫虚边   = 依赖倒置注册表（bootstrap 副作用注册）
//   橙边     = 状态写入（localStorage persist / IndexedDB）
//
// 渲染：dot -Tsvg docs/architecture/10-modules-dependency.dot -o 10-modules-dependency.svg
//       或直接在 Qoder 中预览本 .dot 文件（DOT format viewer）。本机未安装 graphviz。
// ============================================================================
digraph pokerlab_modules {

  graph [rankdir=TB, fontname="Microsoft YaHei, Helvetica", labelloc=t,
         label="PokerLab 模块依赖与共享契约（当前态）\n实线=代码实测 import ｜ 灰虚线=运行时/低置信 ｜ 蓝=shared ｜ 青=事件总线 ｜ 紫=注册表 ｜ 橙=持久化",
         nodesep=0.28, ranksep=0.7, dpi=140, compound=true, newrank=true];
  node  [fontname="Microsoft YaHei, Helvetica", fontsize=11, shape=box, style="rounded,filled",
         fillcolor="#f7f4ee", color="#3f3a33", margin="0.16,0.10"];
  edge  [fontname="Microsoft YaHei, Helvetica", fontsize=9, color="#3f3a33", arrowsize=0.6];

  // ---------------------------------------------------------------- 平台装配层
  subgraph cluster_platform {
    label="平台装配层（src/main.tsx · src/app · src/layouts）"; fontsize=12; style="rounded";
    color="#8a8377"; fillcolor="#efece5";
    main      [label="main.tsx\n入口 bootstrap + SW 注册", fillcolor="#fff8e6"];
    routes    [label="app/routes.tsx\n33 条路由 / lazyPage", fillcolor="#fff8e6"];
    providers [label="app/providers.tsx\ni18n 语言回灌", fillcolor="#fff8e6"];
    layouts   [label="layouts/\nAppLayout · BlankLayout · MobileNav", fillcolor="#fff8e6"];
  }

  // ---------------------------------------------------------------- 训练类模块
  subgraph cluster_training {
    label="交互式训练模块（答题 → 五级反馈 → progress）"; fontsize=12; style="rounded";
    color="#2f6f6a"; fillcolor="#e9f2f0";
    range  [label="range-trainer\n13×13 范围 · 17 预设\nstore 无持久化"];
    odds   [label="pot-odds\n赔率/EV · 19 题\nstore 无持久化"];
    gto    [label="gto-simulator\n运行时生成场景 · 11 spot 翻前库\nstore 无持久化"];
    puzzle [label="puzzle-trainer\n205 题 / 10 主题 / 3 模式\npersist v3"];
  }

  // ---------------------------------------------------------------- 学习类模块
  subgraph cluster_learning {
    label="课程学习模块（内容库 + 学习进度）"; fontsize=12; style="rounded";
    color="#6b4f8a"; fillcolor="#f0ebf5";
    academy [label="strategy-academy\n128 文件（最大模块）\npersist v5"];
    theory  [label="theory-academy\n理论体系 · elo 类型重度引用\npersist v3"];
  }

  // ---------------------------------------------------------------- 支撑类模块
  subgraph cluster_support {
    label="支撑与内容模块"; fontsize=12; style="rounded";
    color="#8a6a3f"; fillcolor="#f6efe4";
    onboard [label="onboarding\n引导流程 / 偏好采集\nstore 无持久化"];
    hh      [label="hand-history\n牌局导入·回放·标注\n3 parser + 自管 IndexedDB\n训练事件豁免"];
    help    [label="help-center\n静态教程 · 无 store.ts"];
  }

  // ---------------------------------------------------------------- 状态中枢
  hub [label="progress（跨模块状态中枢，62 文件）\nStreak · ELO · SRS · Emotion · Mentor\npersist v15 + 训练记录→IndexedDB",
       fillcolor="#ffe9c6", color="#a86a1f", penwidth=1.6];

  // ---------------------------------------------------------------- shared 通道
  subgraph cluster_shared {
    label="src/shared（准入门槛：≥2 模块使用）"; fontsize=12; style="rounded";
    color="#31568f"; fillcolor="#e9eef7";
    s_types  [label="types/\npoker · action · position · quiz\nelo · mentor · training\ndecisionFeedback（五级评级唯一入口）"];
    s_utils  [label="utils/\npokerMath · deck · elo\nseededShuffle · spacedRepetition\nsoundManager · persistShape"];
    s_comp   [label="components/\npoker · feedback · business\nui · layout · gate/SessionLimitGuard"];
    s_stores [label="stores/\ntrainingEvents（总线）\ndebugMode（persist v1）\nachievementRegistry\nacademyDataSourceRegistry"];
    s_hooks  [label="hooks · constants · data\nuseAcademyDataSource · useModuleLabel\nmentorStyles · poker · app · opponentProfiles"];
  }

  // ---------------------------------------------------------------- 数据与运行时
  subgraph cluster_data {
    label="客户端数据与运行时（无后端）"; fontsize=12; style="rounded";
    color="#a83232"; fillcolor="#f8eaea";
    ls   [label="localStorage（zustand persist）\npoker-training-progress v15\nstrategy-academy-progress v5\ntheory-academy-progress v3\npuzzle-trainer-store v3\npoker-debug-mode v1", shape=cylinder];
    idb1 [label="IndexedDB hand-history-db v1\nobjectStore: hands（keyPath id）", shape=cylinder];
    idb2 [label="IndexedDB poker-training-records v1\n训练记录，cleanup 保留最近 1000 条", shape=cylinder];
    idb3 [label="IndexedDB poker-training v1\nstores: records / hands\n[low] 仅经 progress/index.ts 对外导出，\n内部未见消费方 → 待验证是否遗留", shape=cylinder, style="rounded,filled,dashed"];
    sw   [label="Service Worker public/sw.js\n缓存键带 APP_VERSION", style="rounded,filled,dashed"];
    wk   [label="Web Worker gtoWorker.ts\n内嵌 GRADE_THRESHOLDS 隔离拷贝", style="rounded,filled,dashed"];
  }

  subgraph cluster_delivery {
    label="构建与交付（.github/workflows/deploy.yml）"; fontsize=12; style="rounded";
    color="#555555"; fillcolor="#eeeeee";
    ci    [label="GitHub Actions\ninstall→typecheck→lint→test→build→size:check"];
    pages [label="GitHub Pages\nbase = /dezhou/"];
    files [label="外部输入：扑克室手牌历史文本\npokerstars / ggpoker / partypoker", shape=note];
  }

  // ============================================================ 跨模块 import 边
  // 与 ALLOWED_CROSS_IMPORTS 完全一致：7 个模块 → progress，其余模块零出边
  edge [color="#3f3a33", style=solid];
  range   -> hub [label="updateElo / recordAnswer / addReviewItem\nshouldDownshiftDifficulty"];
  odds    -> hub [label="updateElo / recordAnswer / SRS\nrecordTrainingDay"];
  gto     -> hub [label="updateElo(postflop) / recordAnswer / SRS"];
  puzzle  -> hub [label="recordAnswer / recordTrainingDay"];
  academy -> hub [label="store.ts → progress/store"];
  theory  -> hub [label="store.ts → progress/store"];
  onboard -> hub [label="写入 settings 偏好"];

  // ============================================================ shared 通道边
  edge [color="#31568f"];
  range  -> s_types [label="poker/action/position/decisionFeedback"];
  academy-> s_types [constraint=false];
  theory -> s_types [constraint=false, label="elo（23 处）"];
  hh     -> s_types [constraint=false, label="action/poker/position"];
  help   -> s_comp  [constraint=false, label="ui/button + motion"];
  hub    -> s_utils [constraint=false, label="spacedRepetition / elo / persistShape"];
  range  -> s_comp  [constraint=false, label="SessionLimitGuard · QuizCard"];
  odds   -> s_comp  [constraint=false];
  gto    -> s_comp  [constraint=false];
  puzzle -> s_comp  [constraint=false];
  academy-> s_hooks [constraint=false];

  // ============================================================ 事件总线（异步反向通道）
  edge [color="#0f766e", constraint=false];
  range   -> s_stores [label="emit TrainingRecord"];
  odds    -> s_stores [label="emit"];
  gto     -> s_stores [label="emit"];
  puzzle  -> s_stores [label="emit"];
  academy -> s_stores [label="emit"];
  theory  -> s_stores [label="emit"];
  s_stores-> hub [label="store.bootstrap 订阅\n→ 自动累计统计", penwidth=1.5];

  // ============================================================ 依赖倒置注册表
  edge [color="#7c3aed", style=dashed, constraint=false];
  academy -> s_stores [label="store.bootstrap.ts:24-43\nregisterAcademyDataSource + registerAchievementSource"];
  puzzle  -> s_stores [label="store.bootstrap 注册成就数据源"];
  theory  -> s_stores [label="store.bootstrap.ts:12-25 注册成就数据源"];
  hub     -> s_stores [label="store.ts:41 → getAchievementSources()\n成就检查 checkCondition :1036-1105\n（store.ts 不 import academyDataSourceRegistry）", penwidth=1.4];
  hub     -> s_stores [label="utils/dailyTrainingPlan.ts:10,:93 与\ncomponents/replay/ProgressReplay.tsx:7\n→ getAcademyDataSource().findNextLesson()", penwidth=1.2];

  // ============================================================ 持久化写入
  edge [color="#b45309", constraint=false, style=solid];
  hub     -> ls   [label="zustand persist v15"];
  academy -> ls;
  theory  -> ls;
  puzzle  -> ls;
  s_stores-> ls   [label="debugMode v1"];
  hub     -> idb2 [label="addRecord 副作用写库 + cleanup(1000)"];
  hh      -> idb1 [label="loadFromDB / addHands（游标分批 200）"];
  hub     -> idb1 [label="handHistoryBackup 备份/恢复\n跨模块共享同一 DB 名", color="#a83232", style=dashed];
  hub     -> idb3 [color="#9ca3af", style=dashed, label="[low] 未见内部消费"];

  // ============================================================ 装配与运行时
  edge [color="#3f3a33", constraint=false];
  main    -> hub     [label="initProgressStore() 阻塞首屏渲染\n防丢早期训练事件", color="#b45309", penwidth=1.3];
  main    -> academy [label="idle 时动态 import store.bootstrap", color="#b45309"];
  main    -> theory  [label="idle import", color="#b45309"];
  main    -> puzzle  [label="idle import", color="#b45309"];
  routes  -> layouts [style=dashed, color="#6b7280", label="AppLayout / BlankLayout"];
  routes  -> s_comp  [style=dashed, color="#6b7280", label="PageSkeleton / ErrorBoundary"];
  providers -> hub   [style=dashed, color="#6b7280", label="读 settings.language"];
  hh      -> wk      [label="new Worker(type:module)", color="#6b7280"];
  files   -> hh      [label="导入解析", color="#6b7280"];
  ci      -> pages   [label="upload-pages-artifact", color="#6b7280"];
  sw      -> pages   [label="离线缓存 app shell / assets", color="#6b7280"];

  // ============================================================ 布局控制
  { rank=same; range; odds; gto; puzzle; }
  { rank=same; academy; theory; onboard; hh; help; }
  { rank=same; hub; s_stores; }
  { rank=same; ls; idb1; idb2; idb3; sw; wk; }
  { rank=same; ci; pages; files; }
  // 强制 hand-history / help-center 不画向 progress 的边（实测零出边）
  hh -> hub [style=invis];
  help -> hub [style=invis];
}
